{
  "name": "chess-opening-practice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "test": "vitest run --exclude 'test/browser/**' --exclude test/auth.test.ts --exclude test/rules.test.ts",
    "test:browser": "firebase emulators:exec --project demo-no-project --only auth,firestore \"playwright test\"",
    "test:browser:fast": "playwright test --project=stubbed",
    "test:browser:emulated": "firebase emulators:exec --project demo-no-project --only auth,firestore \"playwright test --project=emulated\"",
    "release:check": "bun run build && vitest run test/release-readiness.test.ts",
    "test:emulators": "firebase emulators:exec --only auth,firestore \"vitest run test --exclude 'test/browser/**'\""
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "firebase": "^12.16.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.11.4",
    "firebase-tools": "^14.10.1",
    "happy-dom": "^18.0.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
